{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/fab-profile.schema.json",
  "title": "Fab profile",
  "type": "object",
  "required": ["id", "fab", "url", "retrieved", "layers",
               "min_trace_mm", "min_space_mm",
               "min_pth_hole_mm", "min_npth_hole_mm",
               "annular_ring_mm", "board_edge_mm",
               "silk_min_text_mm", "silk_min_line_mm", "finishes"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "fab": {"type": "string", "minLength": 1},
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/\\s]+\\.[^/\\s]+"
    },
    "retrieved": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "layers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 32}
    },
    "min_trace_mm": {"type": "number", "exclusiveMinimum": 0},
    "min_space_mm": {"type": "number", "exclusiveMinimum": 0},
    "min_via_hole_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "min_pth_hole_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "min_npth_hole_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "annular_ring_mm": {"type": "number", "exclusiveMinimum": 0},
    "board_edge_mm": {"type": "number", "minimum": 0},
    "silk_min_text_mm": {"type": "number", "exclusiveMinimum": 0},
    "silk_min_line_mm": {"type": "number", "exclusiveMinimum": 0},
    "finishes": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "notes": {"type": "string"}
  }
}
